// Schema do Sistema de Gestão de Pedidos (EL-PACK / EXTRUSAICK POLÍMEROS)
// Fase 1 (MVP - paridade com a planilha), conforme Especificacao_Sistema_Gestao_Pedidos.md §3 e §9

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoVenda {
  UNIDADE
  KG
}

enum EtapaPedido {
  EM_PRODUCAO
  FINALIZADO
  ENTREGUE
}

enum SituacaoPrazo {
  ANTECIPADO
  NO_PRAZO
  ATRASADO
}

enum TipoDominio {
  MATERIAL
  COR
  MEDIDA
  MICRAGEM
  TIPO_RESIDUO
  FORMA_PAGAMENTO
}

model Perfil {
  id         String    @id @default(uuid())
  nome       String    @unique
  permissoes Json
  usuarios   Usuario[]

  @@map("perfis")
}

model Usuario {
  id         String    @id @default(uuid())
  nome       String
  email      String    @unique
  senhaHash  String    @map("senha_hash")
  perfilId   String    @map("perfil_id")
  perfil     Perfil    @relation(fields: [perfilId], references: [id])
  ativo      Boolean   @default(true)
  criadoEm   DateTime  @default(now()) @map("criado_em")
  tentativasLogin Int      @default(0) @map("tentativas_login")
  bloqueadoAte    DateTime? @map("bloqueado_ate")

  pedidos       Pedido[]
  statusHist    PedidoStatusHist[]
  auditLogs     AuditLog[]

  @@index([perfilId])
  @@map("usuarios")
}

model Cliente {
  id                 String   @id @default(uuid())
  razaoSocial        String   @map("razao_social")
  nomeFantasia        String?  @map("nome_fantasia")
  cnpjCpf            String   @unique @map("cnpj_cpf")
  inscricaoEstadual  String?  @map("inscricao_estadual")
  email              String?
  telefone           String?
  ativo              Boolean  @default(true)
  criadoEm           DateTime @default(now()) @map("criado_em")

  enderecos Endereco[]
  pedidos   Pedido[]

  @@map("clientes")
}

model Endereco {
  id          String  @id @default(uuid())
  clienteId   String  @map("cliente_id")
  cliente     Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  logradouro  String
  numero      String?
  bairro      String?
  cidade      String
  uf          String
  cep         String?
  principal   Boolean @default(false)

  @@index([clienteId])
  @@map("enderecos")
}

model Produto {
  id             String    @id @default(uuid())
  codigo         Int       @unique @default(autoincrement())
  linha          String?
  material       String
  medida         String
  micragem       String?
  corPadrao      String?   @map("cor_padrao")
  valorUnitario  Decimal   @map("valor_unitario") @db.Decimal(12, 2)
  tipoVenda      TipoVenda @map("tipo_venda")
  pesoKg         Decimal?  @map("peso_kg") @db.Decimal(10, 3)
  ativo          Boolean   @default(true)

  itens ItemPedido[]

  @@map("produtos")
}

model Pedido {
  id                    String        @id @default(uuid())
  numero                Int           @unique
  clienteId             String        @map("cliente_id")
  cliente               Cliente       @relation(fields: [clienteId], references: [id])
  dataPedido            DateTime      @map("data_pedido") @db.Date
  dataEntregaPrevista   DateTime      @map("data_entrega_prevista") @db.Date
  dataFinalizacao       DateTime?     @map("data_finalizacao") @db.Date
  etapa                 EtapaPedido   @default(EM_PRODUCAO)
  formaPagamento        String        @map("forma_pagamento")
  descontoPercentual    Decimal       @default(0) @map("desconto_percentual") @db.Decimal(5, 2)
  valorTotal            Decimal       @default(0) @map("valor_total") @db.Decimal(12, 2)
  valorComDesconto      Decimal       @default(0) @map("valor_com_desconto") @db.Decimal(12, 2)
  observacoes           String?
  situacaoPrazo         SituacaoPrazo? @map("situacao_prazo")
  diasDiferenca         Int?          @map("dias_diferenca")
  usuarioId             String?       @map("usuario_id")
  usuario               Usuario?      @relation(fields: [usuarioId], references: [id])
  criadoEm              DateTime      @default(now()) @map("criado_em")
  atualizadoEm          DateTime      @updatedAt @map("atualizado_em")

  itens      ItemPedido[]
  statusHist PedidoStatusHist[]

  @@index([clienteId])
  @@index([usuarioId])
  @@index([dataPedido])
  @@index([etapa])
  @@map("pedidos")
}

model ItemPedido {
  id             String   @id @default(uuid())
  pedidoId       String   @map("pedido_id")
  pedido         Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId      String   @map("produto_id")
  produto        Produto  @relation(fields: [produtoId], references: [id])
  cor            String?
  quantidade     Decimal  @db.Decimal(12, 3)
  unidade        String
  valorUnitario  Decimal  @map("valor_unitario") @db.Decimal(12, 4)
  valorTotal     Decimal  @map("valor_total") @db.Decimal(12, 2)

  @@index([pedidoId])
  @@index([produtoId])
  @@map("itens_pedido")
}

model PedidoStatusHist {
  id             String       @id @default(uuid())
  pedidoId       String       @map("pedido_id")
  pedido         Pedido       @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  etapaAnterior  EtapaPedido? @map("etapa_anterior")
  etapaNova      EtapaPedido  @map("etapa_nova")
  usuarioId      String?      @map("usuario_id")
  usuario        Usuario?     @relation(fields: [usuarioId], references: [id])
  em             DateTime     @default(now())

  @@index([pedidoId])
  @@map("pedido_status_hist")
}

model AuditLog {
  id         String   @id @default(uuid())
  usuarioId  String?  @map("usuario_id")
  usuario    Usuario? @relation(fields: [usuarioId], references: [id])
  entidade   String
  entidadeId String   @map("entidade_id")
  acao       String
  antes      Json?
  depois     Json?
  em         DateTime @default(now())

  @@index([usuarioId])
  @@index([entidade, entidadeId])
  @@map("audit_log")
}

// Tabelas de domínio parametrizáveis (materiais, cores, micragem, medidas, tipo de resíduo, forma de pagamento)
model Dominio {
  id    String      @id @default(uuid())
  tipo  TipoDominio
  valor String
  ativo Boolean     @default(true)

  @@unique([tipo, valor])
  @@map("dominios")
}

// Parâmetros globais do sistema (ex.: prazo_padrao_dias, empresa_nome, empresa_cnpj)
model Parametro {
  chave String @id
  valor String

  @@map("parametros")
}

// Contador atômico da numeração de pedidos (equivalente ao "Nº inicial do pedido" da planilha).
// Linha única (id fixo = 1); incrementado via UPDATE ... RETURNING para evitar colisão em concorrência.
model SequenciaPedido {
  id            Int @id @default(1)
  proximoNumero Int @map("proximo_numero")

  @@map("sequencia_pedido")
}
