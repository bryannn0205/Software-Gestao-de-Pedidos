# Connection string do PostgreSQL local
# Ajuste usuario/senha/porta conforme sua instalação
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestao_pedidos?schema=public"

# Segredo usado para assinar os tokens JWT — mínimo 32 caracteres, precisa ser
# aleatório (não uma frase legível). Gere um valor novo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="gere-um-valor-aleatorio-de-pelo-menos-32-caracteres-com-o-comando-acima"

# Porta da API
PORT=3333

# Origem(ns) permitida(s) para chamadas ao backend (CORS). Separe por vírgula
# se houver mais de uma (ex.: dev + produção).
CORS_ORIGIN="http://localhost:5173"
